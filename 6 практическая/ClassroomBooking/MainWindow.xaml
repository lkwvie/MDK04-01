<Window 
    x:Class="ClassroomBooking.MainWindow" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    Title="Classroom Booking — 1.0.0" 
    Height="580" 
    Width="840" 
    MinHeight="510" 
    MinWidth="710" 
    WindowStartupLocation="CenterScreen" 
    Background="#F3F6FA">
<Grid 
    Margin="22">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
<StackPanel>
    <TextBlock 
        Text="Бронирование компьютерных аудиторий" 
        FontSize="23" 
        FontWeight="Bold" 
        Foreground="#183153"/>
    <TextBlock 
        Text="Classroom Booking  •  учебная версия 1.0.0" 
        Margin="0,5,0,16" 
        Foreground="#62738A"/>
</StackPanel>
<Border 
    Grid.Row="1" 
    Background="White" 
    CornerRadius="8" 
    Padding="16" 
    Margin="0,0,0,16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
<TextBlock 
    Text="Пользователь" 
    Grid.Row="0" 
    Grid.Column="0"/>
        <TextBlock 
            Text="Аудитория" 
            Grid.Row="0" 
            Grid.Column="1"/>
        <TextBlock 
            Text="Дата" 
            Grid.Row="0" 
            Grid.Column="2"/>
<TextBox 
    x:Name="UserBox" 
    Grid.Row="1" 
    Grid.Column="0" 
    Margin="0,6,12,12" 
    Padding="7" 
    Text="Студент"/>
        <ComboBox 
            x:Name="RoomBox" 
            Grid.Row="1" 
            Grid.Column="1" 
            Margin="0,6,12,12" 
            Padding="7"/>
        <DatePicker 
            x:Name="DateBox" 
            Grid.Row="1" 
            Grid.Column="2" 
            Margin="0,6,12,12"/>
<TextBlock 
    Text="Начало (ЧЧ:ММ)" 
    Grid.Row="2" 
    Grid.Column="0"/>
        <TextBlock 
            Text="Конец (ЧЧ:ММ)" 
            Grid.Row="2" 
            Grid.Column="1"/>
<TextBox 
    x:Name="StartBox" 
    Grid.Row="3" 
    Grid.Column="0" 
    Margin="0,6,12,0" 
    Padding="7" 
    Text="10:00"/>
        <TextBox 
            x:Name="EndBox" 
            Grid.Row="3" 
            Grid.Column="1" 
            Margin="0,6,12,0" 
            Padding="7" 
            Text="11:00"/>
        <Button 
            Grid.Row="3" 
            Grid.Column="2" 
            Grid.ColumnSpan="2" 
            Content="Создать бронирование" 
            Click="Add_Click" 
            Padding="15,8" 
            Background="#2458A6" 
            Foreground="White" 
            BorderThickness="0"/>
    </Grid>
</Border>
<DataGrid 
    x:Name="BookingsGrid" 
    Grid.Row="2" 
    AutoGenerateColumns="False" 
    CanUserAddRows="False" 
    IsReadOnly="True" 
    HeadersVisibility="Column" 
    Background="White">
    <DataGrid.Columns>
        <DataGridTextColumn 
            Header="Пользователь" 
            Binding="{Binding User}" 
            Width="*"/><DataGridTextColumn 
            Header="Аудитория" 
            Binding="{Binding Room}" 
            Width="*"/>
        <DataGridTextColumn 
            Header="Дата" 
            Binding="{Binding Date, StringFormat=dd.MM.yyyy}" 
            Width="*"/>
        <DataGridTextColumn 
            Header="Начало" 
            Binding="{Binding Start}" 
            Width="*"/>
        <DataGridTextColumn 
            Header="Конец" 
            Binding="{Binding End}" 
            Width="*"/>
    </DataGrid.Columns>
</DataGrid>
<DockPanel 
    Grid.Row="3" 
    Margin="0,12,0,0">
    <Button 
        DockPanel.Dock="Right" 
        Content="Сообщить о проблеме"
        Click="SupportButton_Click" 
        Padding="12,6" 
        Margin="8,0,0,0"/>
    <Button 
        DockPanel.Dock="Right" 
        Content="Удалить выбранное"
        Click="Remove_Click" 
        Padding="12,6"/>
    <TextBlock 
        x:Name="StatusMessage" 
        VerticalAlignment="Center" 
        Foreground="#425C75" 
        Text="Готово к работе"/>
</DockPanel>
</Grid>
</Window>
